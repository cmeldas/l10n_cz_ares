<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Seznam kódů bank se mění párkrát do roka (nová banka, sloučení, přejmenování). První běh
             hned po instalaci, pak jednou za měsíc. -->
        <record id="ir_cron_update_bank_codes" model="ir.cron">
            <field name="name">ARES: stáhnout kódy bank od ČNB</field>
            <field name="model_id" ref="model_l10n_cz_ares_bank_codes"/>
            <field name="state">code</field>
            <field name="code">model._cron_update()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
