<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ares_bank_wizard_form" model="ir.ui.view">
        <field name="name">l10n_cz_ares.bank.wizard.form</field>
        <field name="model">l10n_cz_ares.bank.wizard</field>
        <field name="arch" type="xml">
            <form string="Bankovní účty z registru plátců DPH">
                <field name="summary" readonly="1" nolabel="1" class="text-prewrap mb-3"/>
                <div class="alert alert-info mb-3" role="status">
                    V registru plátců DPH je víc zveřejněných účtů, než má kontakt v Odoo. Registr neuvádí,
                    k čemu který účet slouží. Vyber ty, které dodavatel uvádí na fakturách nebo ve smlouvě.
                    Ostatní můžeš přidat později dalším kliknutím na Aktualizovat z ARES.
                </div>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0" no_open="1">
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="display_number"/>
                        <field name="bank_name"/>
                        <field name="published_on"/>
                        <field name="description"/>
                        <field name="account_number" optional="hide"/>
                        <field name="bank_bic" optional="hide"/>
                    </list>
                </field>
                <footer>
                    <button name="action_import" type="object" string="Přidat vybrané" class="btn-primary"/>
                    <button name="action_import_all" type="object" string="Přidat všechny" class="btn-secondary"/>
                    <button special="cancel" string="Nepřidávat" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
